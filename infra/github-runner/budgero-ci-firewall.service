[Unit]
Description=Isolate Budgero CI VM from Dell services and private networks
After=docker.service snap.lxd.daemon.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/budgero-ci-firewall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target docker.service
