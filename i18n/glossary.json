    {
      "id": "ready_to_assign",
      "term": "Ready to Assign",
      "partOfSpeech": "noun",
      "definition": "Money that has arrived but has not yet been given a job. The single most prominent number in the app.",
      "context": "Budget header. Also a docs page title.",
      "uiConstraint": "tight",
      "doNotTranslate": false,
      "translations": {
        "de": {
          "value": "Zu budgetieren",
          "status": "locked",
          "note": "Header needs brevity over precision. Accepts a slight mismatch with the verb \"Zuweisen\" — both read as allocating money, so users map them without friction."
        },
        "fr": {
          "value": "À affecter",
          "status": "locked",
          "note": "'Reste à affecter' is the more idiomatic accounting phrasing but longer. Confirm which reads better in a header."
        },
        "es": {
          "value": "Por asignar",
          "status": "locked",
          "note": "'Listo para asignar' is the literal read; 'Por asignar' is shorter and more natural."
        },
        "nl": {
          "value": "Te verdelen",
          "status": "locked",
          "note": "'Klaar om toe te wijzen' is literal but far too long. Confirm 'Te verdelen' vs 'Nog toe te wijzen'."
        }
      }
    },
